# Copy to .env.local for local runs. All of these are SERVER-ONLY — never exposed to the browser.

# Anthropic API key. With a real key, the three agents call live Claude models.
# Leave empty (or set AGENTS_OFFLINE=1) to use the deterministic offline stub —
# the loop, gate, and NDJSON stream all run end-to-end with zero external setup.
ANTHROPIC_API_KEY=

# Force the offline stub even when a key is present (useful for CI / demos).
# AGENTS_OFFLINE=1

# Optional per-role model overrides (Haiku/Sonnet tier). Defaults shown.
# RESEARCHER_MODEL=claude-haiku-4-5
# REASONER_MODEL=claude-sonnet-4-6
# EXECUTOR_MODEL=claude-haiku-4-5

# Consensus triad (optional). When these keys are set, the Reasoner step also asks
# Gemini and Grok to propose the action; the gate's require-model-consensus rule
# holds the run for a human if the models disagree. Missing key ⇒ that model simply
# abstains. Model ids drift — set them to ids current for your account.
# GEMINI_API_KEY=
# XAI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# XAI_MODEL=grok-3

# Optional: route retrieval to a live memory service over the C3 contract
# (POST /recall -> { records: MemoryRecord[] }). Unset = bundled in-memory corpus
# (default, zero setup). Example is the live P1 memory-service deployment:
# MEMORY_SERVICE_URL=https://agent-memory-service-voiwkzrlma-uc.a.run.app

# --- Intervention console (/console) — see docs/COSIGN.md --------------------
# Which governance source backs the cosign queue / fleet / drift surfaces.
#   simulator (default) = zero-infra, synthetic, scripted, safe for public exposure.
#   cognigate           = live CogniGate REQUIRE_COSIGN path + ASTS sink (inert until G2/G3).
# GOVERNANCE_SOURCE=simulator

# Operator identity for the cosign write path (every decision is attributed to this human in
# the audit chain). Optional in simulator mode (a demo operator is used); REQUIRED in live
# mode — without it, decisions are refused as unauthenticated (fail-closed).
# OPERATOR_ID=
# OPERATOR_NAME=

# Live-path only (GOVERNANCE_SOURCE=cognigate). All server-side; never NEXT_PUBLIC except the
# anon key used for read-only Realtime in the browser. See supabase/README.md.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CRON_SECRET=          # the TTL sweeper requires `Authorization: Bearer $CRON_SECRET` in live mode
