{
  "name": "governed-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Governed multi-agent flow — Researcher → Reasoner → governance gate → execute/halt — with a trace UI rendered purely from the TraceEvent stream.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:model": "tsx scripts/check-model.ts",
    "check:providers": "tsx scripts/check-providers.ts",
    "verify:governance": "tsx scripts/verify-governance.ts",
    "verify:cosign": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-cosign.ts",
    "demo": "tsx scripts/run.ts",
    "demo:allow": "tsx scripts/run.ts allowed",
    "demo:block": "tsx scripts/run.ts blocked"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/supabase-js": "^2.108.2",
    "@xyflow/react": "^12.3.6",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
